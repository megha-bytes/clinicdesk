# ClinicDesk environment variables. NAMES ONLY here; never commit real values.
# Dev: copy this file to .env.local (git-ignored) and fill in your own values.
# Prod (free host): set these in the host's environment/secrets settings.

APP_ENV=dev                     # dev | prod | test

# --- Secrets backend ---
SECRETS_PROVIDER=env            # env (laptop, CI, free host) | secretstash (Nebius VM, upgrade path)
SECRETSTASH_SECRET_ID=          # only for secretstash

# --- Nebius Token Factory (Nemotron) ---
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- Tavily (clinic onboarding, from Day 18) ---
TAVILY_API_KEY=

# --- Payments (TEST MODE ONLY) ---
PAYMENT_PROVIDER=mock           # mock | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Database ---
# Laptop without Docker: leave unset to use a local SQLite file.
# Docker compose sets this automatically. Free host: paste your Neon/Supabase URL.
DATABASE_URL=

# --- Web ---
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
JWT_SIGNING_KEY=
A2A_API_KEYS=                   # comma-separated; hashed at rest

# --- Observability (OpenTelemetry) ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=clinicdesk
OTEL_EXPORTER_OTLP_ENDPOINT=    # http://localhost:4317 with docker compose; empty = no export

# --- Demo ops ---
DEMO_RESET_TOKEN=
DAILY_SPEND_CAP_USD=2.00
