# ClinicDesk environment variables — NAMES ONLY, never commit real values.
# Dev: copy to .env.local (git-ignored) and fill in.
# Prod: values come from Nebius SecretStash (MysteryBox) at runtime; leave these unset.

# --- Secrets backend ---
SECRETS_PROVIDER=env            # env | secretstash
SECRETSTASH_SECRET_ID=          # Nebius SecretStash secret id (prod only)

# --- Nebius Token Factory (Nemotron) ---
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/   # verify in the Token Factory console

# --- Tavily (clinic onboarding) ---
TAVILY_API_KEY=

# --- Payments (TEST MODE ONLY) ---
PAYMENT_PROVIDER=mock           # mock | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Database ---
DATABASE_URL=postgresql+psycopg://clinicdesk:clinicdesk@localhost:5432/clinicdesk

# --- Auth ---
JWT_SIGNING_KEY=
A2A_API_KEYS=                   # comma-separated; hashed at rest in prod

# --- Observability (OpenTelemetry) ---
OTEL_SERVICE_NAME=clinicdesk
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_HEADERS=

# --- Demo ops ---
DEMO_RESET_TOKEN=
DAILY_SPEND_CAP_USD=2.00
