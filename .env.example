# ClinicDesk environment variables. NAMES ONLY here; never commit real values.
# Dev: copy this file to .env.local (git-ignored) and fill in your own values.
# Prod (free host): set these in the host's environment/secrets settings.

APP_ENV=dev                     # dev | prod | test

# --- Secrets backend ---
SECRETS_PROVIDER=env            # env (laptop, CI, free host) | secretstash (Nebius VM, upgrade path)
SECRETSTASH_SECRET_ID=          # only for secretstash

# --- Nebius Token Factory (Nemotron) ---
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- Tavily (clinic onboarding, from Day 18) ---
TAVILY_API_KEY=

# --- Payments (TEST MODE ONLY) ---
PAYMENT_PROVIDER=mock           # mock | razorpay (rzp_test_ keys only)
PUBLIC_BASE_URL=http://localhost:8000   # base for mock payment links
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Database ---
# Laptop without Docker: leave unset to use a local SQLite file.
# Docker compose sets this automatically. Free host: paste your Neon/Supabase URL.
DATABASE_URL=

# --- Web ---
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
# Staff sessions are random bearer tokens stored hashed in the database (no signing key needed)
A2A_DEMO_KEY=                   # the demo companion's A2A key (hashed at rest); more: py -m app.a2a.auth create "Name"

# --- Observability (OpenTelemetry) ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=clinicdesk
# http://localhost:4317 with docker compose; leave empty for no export
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Demo ops ---
DEMO_RESET_TOKEN=

# Staff accounts (Day 21). Optional owner bootstrap; or: cd backend && py -m app.auth create --role owner ...
OWNER_EMAIL=
OWNER_PASSWORD=
# One-click demo staff sessions for the public demo clinic (true on the hackathon demo)
DEMO_LOGIN_ENABLED=true
DAILY_SPEND_CAP_USD=2.00
